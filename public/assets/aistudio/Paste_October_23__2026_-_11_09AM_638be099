        {
          "args": "p_user bigint",
          "name": "_active_count",
          "returns": "integer",
          "definition": "CREATE OR REPLACE FUNCTION public._active_count(p_user bigint)\n RETURNS integer\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\r\n    select count(distinct case when w.from_id = p_user then w.to_id else w.from_id end)::int\r\n      from public.waves w\r\n     where w.status = 'matched' and p_user in (w.from_id, w.to_id);\r\n$function$\n",
          "security_definer": false
        },
        {
          "args": "t text",
          "name": "_city_key",
          "returns": "text",
          "definition": "CREATE OR REPLACE FUNCTION public._city_key(t text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO ''\nAS $function$ select lower(replace(btrim(coalesce(t, '')), 'ё', 'е')) $function$\n",
          "security_definer": false
        },
        {
          "args": "",
          "name": "_me",
          "returns": "bigint",
          "definition": "CREATE OR REPLACE FUNCTION public._me()\n RETURNS bigint\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$ select nullif(auth.jwt()->>'sub','')::bigint $function$\n",
          "security_definer": false
        },
        {
          "args": "p_user bigint, p_kind text, p_data jsonb DEFAULT '{}'::jsonb",
          "name": "_notify",
          "returns": "void",
          "definition": "CREATE OR REPLACE FUNCTION public._notify(p_user bigint, p_kind text, p_data jsonb DEFAULT '{}'::jsonb)\n RETURNS void\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n    insert into public.notifications (user_id, kind, data) values (p_user, p_kind, coalesce(p_data, '{}'::jsonb));\r\n$function$\n",
          "security_definer": true
        },
        {
          "args": "",
          "name": "_profile_city_guard",
          "returns": "trigger",
          "definition": "CREATE OR REPLACE FUNCTION public._profile_city_guard()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare c public.cities%rowtype;\r\nbegin\r\n    if new.tg_id < 0 then return new; end if;\r\n    if tg_op = 'UPDATE' and new.city is not distinct from old.city then return new; end if;\r\n    select * into c from public.cities where key = public._city_key(new.city);\r\n    if not found then\r\n        raise exception 'unknown_city' using errcode = '23514', hint = 'Выберите город из списка';\r\n    end if;\r\n    new.city := c.name;\r\n    return new;\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "",
          "name": "_push_notification",
          "returns": "trigger",
          "definition": "CREATE OR REPLACE FUNCTION public._push_notification()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n    declare url text; secret text;\r\n    begin\r\n        if new.user_id < 0 then return new; end if;\r\n        if new.kind = 'like' and exists (select 1 from public.notifications n\r\n             where n.user_id = new.user_id and n.kind = 'like' and n.id <> new.id\r\n               and n.created_at > now() - interval '30 minutes') then\r\n            return new;\r\n        end if;\r\n        select decrypted_secret into url    from vault.decrypted_secrets where name = 'wave_notify_url';\r\n        select decrypted_secret into secret from vault.decrypted_secrets where name = 'wave_notify_secret';\r\n        if url is null or secret is null then return new; end if;\r\n        begin\r\n            perform net.http_post(\r\n                url := url,\r\n                headers := jsonb_build_object('Content-Type', 'application/json', 'x-notify-secret', secret),\r\n                body := jsonb_build_object('user_id', new.user_id, 'kind', new.kind, 'data', new.data));\r\n        exception when others then null;\r\n        end;\r\n        return new;\r\n    end $function$\n",
          "security_definer": true
        },
        {
          "args": "",
          "name": "clear_notifications",
          "returns": "integer",
          "definition": "CREATE OR REPLACE FUNCTION public.clear_notifications()\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare n int;\r\nbegin\r\n    delete from public.notifications where user_id = public._me() and read_at is not null;\r\n    get diagnostics n = row_count;\r\n    return n;\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "p_ids bigint[]",
          "name": "consume_notifications",
          "returns": "integer",
          "definition": "CREATE OR REPLACE FUNCTION public.consume_notifications(p_ids bigint[])\n RETURNS integer\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n    select public.mark_notifications_read(p_ids);\r\n$function$\n",
          "security_definer": true
        },
        {
          "args": "p_me bigint",
          "name": "dev_fake_accept",
          "returns": "integer",
          "definition": "CREATE OR REPLACE FUNCTION public.dev_fake_accept(p_me bigint)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare r record; n int := 0;\r\nbegin\r\n    -- фейки, которых вы лайкнули, отвечают взаимностью — не больше, чем у вас свободных слотов\r\n    for r in (select w.id, w.to_id from public.waves w\r\n               where w.from_id = p_me and w.to_id < 0 and w.status = 'pending' order by w.created_at\r\n               limit greatest(public.wave_max_slots() - public._active_count(p_me), 0)) loop\r\n        update public.waves set status = 'matched', resolved_at = now() where id = r.id;\r\n        perform public._notify(p_me, 'match', jsonb_build_object('name', (select name from public.profiles where tg_id = r.to_id)));\r\n        n := n + 1;\r\n    end loop;\r\n    return n;\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "p_me bigint, p_n integer DEFAULT 3",
          "name": "dev_fake_waves",
          "returns": "integer",
          "definition": "CREATE OR REPLACE FUNCTION public.dev_fake_waves(p_me bigint, p_n integer DEFAULT 3)\n RETURNS integer\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare n int;\r\nbegin\r\n    with me as (select * from public.profiles where tg_id = p_me),\r\n    ins as (\r\n        insert into public.waves (from_id, to_id, message)\r\n        select f.tg_id, p_me,\r\n               case when f.tg_id % 3 = 0 then null\r\n                    else (array['Привет! Кажется, у нас много общего','Привет! Как проходит твой день?',\r\n                                'Хай! Давай знакомиться','Привет! Ты тоже любишь активный отдых?'])[1 + (abs(f.tg_id) % 4)::int] end\r\n        from public.profiles f, me\r\n        where f.tg_id < 0\r\n          and (me.looking = 'any' or me.looking = f.gender)\r\n          and (f.looking  = 'any' or f.looking  = me.gender)\r\n          and not exists (select 1 from public.waves w\r\n                           where (w.from_id = f.tg_id and w.to_id = p_me) or (w.from_id = p_me and w.to_id = f.tg_id))\r\n        order by f.tg_id desc limit p_n\r\n        returning 1)\r\n    select count(*) into n from ins;\r\n    perform public._notify(p_me, 'like') from generate_series(1, n);\r\n    return n;\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "p_me bigint",
          "name": "dev_reset",
          "returns": "void",
          "definition": "CREATE OR REPLACE FUNCTION public.dev_reset(p_me bigint)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n    delete from public.waves  where from_id = p_me or to_id = p_me;\r\n    delete from public.passes where user_id = p_me;\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "p_intent text DEFAULT NULL::text, p_same_city boolean DEFAULT false, p_limit integer DEFAULT 30, p_offset integer DEFAULT 0",
          "name": "discover",
          "returns": "TABLE(id bigint, name text, age integer, gender text, city text, intents text[], shared text[], bio text, photo_path text, score numeric, distance_km integer, zone integer)",
          "definition": "CREATE OR REPLACE FUNCTION public.discover(p_intent text DEFAULT NULL::text, p_same_city boolean DEFAULT false, p_limit integer DEFAULT 30, p_offset integer DEFAULT 0)\n RETURNS TABLE(id bigint, name text, age integer, gender text, city text, intents text[], shared text[], bio text, photo_path text, score numeric, distance_km integer, zone integer)\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n    with me as (\r\n        select p.tg_id, p.gender, p.looking, p.age, p.intents, p.city, c.lat, c.lon\r\n          from public.profiles p\r\n          left join public.cities c on c.key = public._city_key(p.city)\r\n         where p.tg_id = public._me()\r\n    ), base as (\r\n        select p.tg_id, p.name, p.age, p.gender, p.city, p.intents, p.bio, p.photo_path, p.updated_at, s.shared,\r\n               abs(p.age - me.age) as age_diff,\r\n               case when public._city_key(p.city) = public._city_key(me.city) then 0\r\n                    when me.lat is null or c.lat is null then null\r\n                    else (round(2 * 6371 * asin(sqrt(least(1,\r\n                           power(sin(radians(c.lat - me.lat) / 2), 2)\r\n                         + cos(radians(me.lat)) * cos(radians(c.lat)) * power(sin(radians(c.lon - me.lon) / 2), 2)\r\n                         ))) / 5) * 5)::int\r\n               end as dist\r\n          from public.profiles p\r\n          cross join me\r\n          left join public.cities c on c.key = public._city_key(p.city)\r\n          cross join lateral (\r\n              select array(select i from unnest(p.intents) i intersect select i from unnest(me.intents) i) as shared\r\n          ) s\r\n         where p.tg_id <> me.tg_id\r\n           and (me.looking = 'any' or me.looking = p.gender)\r\n           and (p.looking  = 'any' or p.looking  = me.gender)\r\n           and (p_intent is null or p_intent = any(p.intents))\r\n           and not exists (select 1 from public.passes x\r\n                            where x.user_id = me.tg_id and x.target_id = p.tg_id\r\n                              and x.created_at > now() - public.wave_pass_ttl())\r\n           and not exists (select 1 from public.waves w\r\n                            where (w.from_id = me.tg_id and w.to_id = p.tg_id)\r\n                               or (w.from_id = p.tg_id and w.to_id = me.tg_id))\r\n    )\r\n    select b.tg_id, b.name, b.age, b.gender, b.city, b.intents, b.shared, b.bio, b.photo_path,\r\n           (cardinality(b.shared) * 10 - b.age_diff * 0.5)::numeric,\r\n           b.dist,\r\n           case when b.dist = 0 then 0 when b.dist <= 60 then 1 when b.dist <= 150 then 2\r\n                when b.dist <= 300 then 3 else 4 end\r\n      from base b\r\n     where b.dist is not null and (not p_same_city or b.dist = 0)\r\n     order by 12, 10 desc, b.updated_at desc\r\n     limit least(p_limit, 50) offset greatest(p_offset, 0);\r\n$function$\n",
          "security_definer": true
        },
        {
          "args": "p_other bigint",
          "name": "end_wave",
          "returns": "jsonb",
          "definition": "CREATE OR REPLACE FUNCTION public.end_wave(p_other bigint)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare me bigint := public._me(); n int;\r\nbegin\r\n    update public.waves set status = 'ended', resolved_at = now()\r\n     where status = 'matched'\r\n       and ((from_id = me and to_id = p_other) or (from_id = p_other and to_id = me));\r\n    get diagnostics n = row_count;\r\n    if n > 0 then\r\n        perform public._notify(p_other, 'ended', jsonb_build_object('name', (select name from public.profiles where tg_id = me)));\r\n    end if;\r\n    return jsonb_build_object('result', case when n > 0 then 'ended' else 'gone' end);\r\nend $function$\n",
          "security_definer": true
        },
        {
          "args": "p_ids bigint[]",
