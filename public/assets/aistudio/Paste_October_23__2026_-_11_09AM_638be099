          "returns": "jsonb",
          "definition": "CREATE OR REPLACE FUNCTION public.send_wave(p_to bigint, p_message text DEFAULT NULL::text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n    me bigint := public._me();\r\n    msg text := nullif(left(btrim(coalesce(p_message, '')), 200), '');\r\n    rev_id bigint;\r\nbegin\r\n    if me is null or p_to is null or me = p_to\r\n       or not exists (select 1 from public.profiles where tg_id = me)\r\n       or not exists (select 1 from public.profiles where tg_id = p_to) then\r\n        return jsonb_build_object('result', 'invalid');\r\n    end if;\r\n\r\n    perform pg_advisory_xact_lock(least(me, p_to));       -- блокируем обоих (всегда в одном порядке)\r\n    perform pg_advisory_xact_lock(greatest(me, p_to));\r\n\r\n    if exists (select 1 from public.waves where from_id = me and to_id = p_to) then\r\n        return jsonb_build_object('result', 'exists');\r\n    end if;\r\n\r\n    select id into rev_id from public.waves where from_id = p_to and to_id = me and status = 'pending';\r\n\r\n    if rev_id is null then\r\n        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);\r\n        perform public._notify(p_to, 'like');\r\n        return jsonb_build_object('result', 'sent');\r\n    end if;\r\n\r\n    -- человек уже лайкнул меня: пробуем начать волну (нужны свободные слоты у обоих)\r\n    if public._active_count(me) >= public.wave_max_slots() then\r\n        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);\r\n        perform public._notify(p_to, 'like');\r\n        return jsonb_build_object('result', 'liked_no_slot');\r\n    end if;\r\n    if public._active_count(p_to) >= public.wave_max_slots() then\r\n        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);\r\n        perform public._notify(p_to, 'like');\r\n        return jsonb_build_object('result', 'liked_target_full');\r\n    end if;\r\n\r\n    u