                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| wave_status               | CREATE OR REPLACE FUNCTION public.wave_status()<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare me bigint := public._me();<br>begin<br>    return jsonb_build_object(<br>        'used',     public._active_count(me),<br>        'max',      public.wave_max_slots(),<br>        'incoming', (select count(*) from public.waves where to_id = me and status = 'pending'),<br>        'unread',   (select count(*) from public.notifications where user_id = me and read_at is null));<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              