| dev_fake_accept           | CREATE OR REPLACE FUNCTION public.dev_fake_accept(p_me bigint)<br> RETURNS integer<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare r record; n int := 0;<br>begin<br>    -- фейки, которых вы лайкнули, отвечают взаимностью — не больше, чем у вас свободных слотов<br>    for r in (select w.id, w.to_id from public.waves w<br>               where w.from_id = p_me and w.to_id < 0 and w.status = 'pending' order by w.created_at<br>               limit greatest(public.wave_max_slots() - public._active_count(p_me), 0)) loop<br>        update public.waves set status = 'matched', resolved_at = now() where id = r.id;<br>        perform public._notify(p_me, 'match', jsonb_build_object('name', (select name from public.profiles where tg_id = r.to_id)));<br>        n := n + 1;<br>    end loop;<br>    return n;<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| dev_fake_waves            | CREATE OR REPLACE FUNCTION public.dev_fake_waves(p_me bigint, p_n integer DEFAULT 3)<br> RETURNS integer<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare n int;<br>begin<br>    with me as (select * from public.profiles where tg_id = p_me),<br>    ins as (<br>        insert into public.waves (from_id, to_id, message)<br>        select f.tg_id, p_me,<br>               case when f.tg_id % 3 = 0 then null<br>                    else (array['Привет! Кажется, у нас много общего','Привет! Как проходит твой день?',<br>                                'Хай! Давай знакомиться','Привет! Ты тоже любишь активный отдых?'])[1 + (abs(f.tg_id) % 4)::int] end<br>        from public.profiles f, me<br>        where f.tg_id < 0<br>          and (me.looking = 'any' or me.looking = f.gender)<br>          and (f.looking  = 'any' or f.looking  = me.gender)<br>          and not exists (select 1 from public.waves w<br>                           where (w.from_id = f.tg_id and w.to_id = p_me) or (w.from_id = p_me and w.to_id = f.tg_id))<br>        order by f.tg_id desc limit p_n<br>        returning 1)<br>    select count(*) into n from ins;<br>    perform public._notify(p_me, 'like') from generate_series(1, n);<br>    return n;<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 |
| dev_reset                 | CREATE OR REPLACE FUNCTION public.dev_reset(p_me bigint)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>begin<br>    delete from public.waves  where from_id = p_me or to_id = p_me;<br>    delete from public.passes where user_id = p_me;<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| discover                  | CREATE OR REPLACE FUNCTION public.discover(p_intent text DEFAULT NULL::text, p_same_city boolean DEFAULT false, p_limit integer DEFAULT 30, p_offset integer DEFAULT 0)<br> RETURNS TABLE(id bigint, name text, age integer, gender text, city text, intents text[], shared text[], bio text, photo_path text, score numeric, distance_km integer, zone integer)<br> LANGUAGE sql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>    with me as (<br>        select p.tg_id, p.gender, p.looking, p.age, p.intents, p.city, c.lat, c.lon<br>          from public.profiles p<br>          left join public.cities c on c.key = public._city_key(p.city)<br>         where p.tg_id = public._me()<br>    ), base as (<br>        select p.tg_id, p.name, p.age, p.gender, p.city, p.intents, p.bio, p.photo_path, p.updated_at, s.shared,<br>               abs(p.age - me.age) as age_diff,<br>               case when public._city_key(p.city) = public._city_key(me.city) then 0<br>                    when me.lat is null or c.lat is null then null<br>                    else (round(2 * 6371 * asin(sqrt(least(1,<br>                           power(sin(radians(c.lat - me.lat) / 2), 2)<br>                         + cos(radians(me.lat)) * cos(radians(c.lat)) * power(sin(radians(c.lon - me.lon) / 2), 2)<br>                         ))) / 5) * 5)::int<br>               end as dist<br>          from public.profiles p<br>          cross join me<br>          left join public.cities c on c.key = public._city_key(p.city)<br>          cross join lateral (<br>              select array(select i from unnest(p.intents) i intersect select i from unnest(me.intents) i) as shared<br>          ) s<br>         where p.tg_id <> me.tg_id<br>           and not p.is_hidden<br>           and (me.looking = 'any' or me.looking = p.gender)<br>           and (p.looking  = 'any' or p.looking  = me.gender)<br>           and (p_intent is null or p_intent = any(p.intents))<br>           and not exists (select 1 from public.passes x<br>                            where x.user_id = me.tg_id and x.target_id = p.tg_id<br>                              and x.created_at > now() - public.wave_pass_ttl())<br>           and not exists (select 1 from public.waves w<br>                            where (w.from_id = me.tg_id and w.to_id = p.tg_id)<br>                               or (w.from_id = p.tg_id and w.to_id = me.tg_id))<br>    )<br>    select b.tg_id, b.name, b.age, b.gender, b.city, b.intents, b.shared, b.bio, b.photo_path,<br>           (cardinality(b.shared) * 10 - b.age_diff * 0.5)::numeric,<br>           b.dist,<br>           case when b.dist = 0 then 0 when b.dist <= 60 then 1 when b.dist <= 150 then 2<br>                when b.dist <= 300 then 3 else 4 end<br>      from base b<br>     where b.dist is not null and (not p_same_city or b.dist = 0)<br>     order by 12, 10 desc, b.updated_at desc<br>     limit least(p_limit, 50) offset greatest(p_offset, 0);<br>$function$<br> |
| end_wave                  | CREATE OR REPLACE FUNCTION public.end_wave(p_other bigint)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare me bigint := public._me(); n int;<br>begin<br>    update public.waves set status = 'ended', resolved_at = now()<br>     where status = 'matched'<br>       and ((from_id = me and to_id = p_other) or (from_id = p_other and to_id = me));<br>    get diagnostics n = row_count;<br>    if n > 0 then<br>        perform public._notify(p_other, 'ended', jsonb_build_object('name', (select name from public.profiles where tg_id = me)));<br>    end if;<br>    return jsonb_build_object('result', case when n > 0 then 'ended' else 'gone' end);<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     