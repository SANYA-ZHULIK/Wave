| report_user               | CREATE OR REPLACE FUNCTION public.report_user(p_target bigint, p_reason text DEFAULT 'other'::text, p_details text DEFAULT NULL::text)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare<br>  me bigint := public._me();<br>begin<br>  if me is null or p_target is null or me = p_target then<br>    return;<br>  end if;<br><br>  insert into public.reports (from_user, target_user, reason, details)<br>  values (me, p_target, coalesce(nullif(trim(p_reason), ''), 'other'), nullif(trim(p_details), ''));<br>end;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |
| reset_my_passes           | CREATE OR REPLACE FUNCTION public.reset_my_passes()<br> RETURNS void<br> LANGUAGE sql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>  delete from public.passes where user_id = public._me();<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| respond_wave              | CREATE OR REPLACE FUNCTION public.respond_wave(p_wave_id bigint, p_accept boolean)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare me bigint := public._me(); w public.waves%rowtype;<br>begin<br>    select * into w from public.waves where id = p_wave_id and to_id = me and status = 'pending';<br>    if not found then return jsonb_build_object('result', 'gone'); end if;<br><br>    perform pg_advisory_xact_lock(least(me, w.from_id));<br>    perform pg_advisory_xact_lock(greatest(me, w.from_id));<br><br>    select * into w from public.waves where id = p_wave_id and to_id = me and status = 'pending' for update;<br>    if not found then return jsonb_build_object('result', 'gone'); end if;<br><br>    if not p_accept then<br>        update public.waves set status = 'declined', resolved_at = now()<br>         where status = 'pending'<br>           and ((from_id = w.from_id and to_id = me) or (from_id = me and to_id = w.from_id));<br>        return jsonb_build_object('result', 'declined');<br>    end if;<br><br>    if public._active_count(me)        >= public.wave_max_slots() then return jsonb_build_object('result', 'no_slots');    end if;<br>    if public._active_count(w.from_id) >= public.wave_max_slots() then return jsonb_build_object('result', 'target_full'); end if;<br><br>    update public.waves set status = 'matched', resolved_at = now()<br>     where status = 'pending'<br>       and ((from_id = w.from_id and to_id = me) or (from_id = me and to_id = w.from_id));<br>    perform public._notify(w.from_id, 'match', jsonb_build_object('name', (select name from public.profiles where tg_id = me)));<br>    return jsonb_build_object('result', 'matched');<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
| rls_auto_enable           | CREATE OR REPLACE FUNCTION public.rls_auto_enable()<br> RETURNS event_trigger<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'pg_catalog'<br>AS $function$<br>DECLARE<br>  cmd record;<br>  tbl name;<br>BEGIN<br>  FOR cmd IN<br>    SELECT *<br>    FROM pg_event_trigger_ddl_commands()<br>    WHERE command_tag IN ('CREATE TABLE', 'CREATE TABLE AS', 'SELECT INTO')<br>      AND object_type IN ('table','partitioned table')<br>  LOOP<br>     IF cmd.schema_name IS NOT NULL AND cmd.schema_name IN ('public') AND cmd.schema_name NOT IN ('pg_catalog','information_schema') AND cmd.schema_name NOT LIKE 'pg_toast%' AND cmd.schema_name NOT LIKE 'pg_temp%' THEN<br>      BEGIN<br>        SELECT c.relname INTO tbl FROM pg_catalog.pg_class c WHERE c.oid = cmd.objid;<br>        EXECUTE format('alter table if exists %I.%I enable row level security', cmd.schema_name, tbl);<br>        RAISE LOG 'rls_auto_enable: enabled RLS on %', cmd.object_identity;<br>      EXCEPTION<br>        WHEN OTHERS THEN<br>          RAISE LOG 'rls_auto_enable: failed to enable RLS on %', cmd.object_identity;<br>      END;<br>     ELSE<br>        RAISE LOG 'rls_auto_enable: skip % (either system schema or not in enforced list: %.)', cmd.object_identity, cmd.schema_name;<br>     END IF;<br>  END LOOP;<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| send_wave                 | CREATE OR REPLACE FUNCTION public.send_wave(p_to bigint, p_message text DEFAULT NULL::text)<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare<br>    me bigint := public._me();<br>    msg text := nullif(left(btrim(coalesce(p_message, '')), 200), '');<br>    rev_id bigint;<br>begin<br>    if me is null or p_to is null or me = p_to<br>       or not exists (select 1 from public.profiles where tg_id = me)<br>       or not exists (select 1 from public.profiles where tg_id = p_to) then<br>        return jsonb_build_object('result', 'invalid');<br>    end if;<br><br>    perform pg_advisory_xact_lock(least(me, p_to));       -- блокируем обоих (всегда в одном порядке)<br>    perform pg_advisory_xact_lock(greatest(me, p_to));<br><br>    if exists (select 1 from public.waves where from_id = me and to_id = p_to) then<br>        return jsonb_build_object('result', 'exists');<br>    end if;<br><br>    select id into rev_id from public.waves where from_id = p_to and to_id = me and status = 'pending';<br><br>    if rev_id is null then<br>        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);<br>        perform public._notify(p_to, 'like');<br>        return jsonb_build_object('result', 'sent');<br>    end if;<br><br>    -- человек уже лайкнул меня: пробуем начать волну (нужны свободные слоты у обоих)<br>    if public._active_count(me) >= public.wave_max_slots() then<br>        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);<br>        perform public._notify(p_to, 'like');<br>        return jsonb_build_object('result', 'liked_no_slot');<br>    end if;<br>    if public._active_count(p_to) >= public.wave_max_slots() then<br>        insert into public.waves (from_id, to_id, message) values (me, p_to, msg);<br>        perform public._notify(p_to, 'like');<br>        return jsonb_build_object('result', 'liked_target_full');<br>    end if;<br><br>    update public.waves set status = 'matched', resolved_at = now() where id = rev_id;<br>    insert into public.waves (from_id, to_id, message, status, resolved_at) values (me, p_to, msg, 'matched', now());<br>    perform public._notify(p_to, 'match', jsonb_build_object('name', (select name from public.profiles where tg_id = me)));<br>    return jsonb_build_object('result', 'matched');<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       |
| unblock_user              | CREATE OR REPLACE FUNCTION public.unblock_user(p_target bigint)<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>begin<br>  delete from public.blocks<br>  where user_id = public._me() and target_id = p_target;<br>end;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
| wave_cleanup              | CREATE OR REPLACE FUNCTION public.wave_cleanup()<br> RETURNS jsonb<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare p int; n int;<br>begin<br>    delete from public.passes where created_at < now() - public.wave_pass_ttl();<br>    get diagnostics p = row_count;<br>    delete from public.notifications<br>     where (read_at is not null and read_at < now() - interval '30 days')<br>        or created_at < now() - interval '90 days';<br>    get diagnostics n = row_count;<br>    return jsonb_build_object('passes_deleted', p, 'notifications_deleted', n);<br>end $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| wave_max_slots            | CREATE OR REPLACE FUNCTION public.wave_max_slots()<br> RETURNS integer<br> LANGUAGE sql<br> IMMUTABLE<br> SET search_path TO ''<br>AS $function$ select 3 $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
