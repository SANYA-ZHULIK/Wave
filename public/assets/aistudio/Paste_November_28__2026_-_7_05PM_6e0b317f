| delete_my_account         | CREATE OR REPLACE FUNCTION public.delete_my_account()<br> RETURNS void<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>declare<br>  me bigint := public._me();<br>begin<br>  if me is null then<br>    return;<br>  end if;<br><br>  delete from public.notifications where user_id = me;<br>  delete from public.passes where user_id = me or target_id = me;<br>  delete from public.blocks where user_id = me or target_id = me;<br>  delete from public.waves where from_id = me or to_id = me;<br>  delete from public.profiles where tg_id = me;<br>end;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    