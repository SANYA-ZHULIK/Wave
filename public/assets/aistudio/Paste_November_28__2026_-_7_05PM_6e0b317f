                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |
| my_incoming               | CREATE OR REPLACE FUNCTION public.my_incoming()<br> RETURNS TABLE(wave_id bigint, id bigint, name text, age integer, city text, intents text[], shared text[], bio text, photo_path text, message text, created_at timestamp with time zone)<br> LANGUAGE sql<br> SECURITY DEFINER<br> SET search_path TO 'public'<br>AS $function$<br>    select w.id, p.tg_id, p.name, p.age, p.city, p.intents, s.shared, p.bio, p.photo_path, w.message, w.created_at<br>    from public.waves w<br>    join public.profiles p  on p.tg_id  = w.from_id<br>    join public.profiles me on me.tg_id = public._me()<br>    cross join lateral (<br>        select array(select i from unnest(p.intents) i intersect select i from unnest(me.intents) i) as shared<br>    ) s<br>    where w.to_id = me.tg_id and w.status = 'pending'<br>    order by w.created_at;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           